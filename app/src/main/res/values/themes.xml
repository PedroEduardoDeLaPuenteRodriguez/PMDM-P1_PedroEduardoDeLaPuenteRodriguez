<resources>

    <style name="Theme.AguaDiaria" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primario</item>
        <item name="colorPrimaryVariant">@color/color_primario_oscuro</item>
        <item name="colorOnPrimary">@color/color_texto_sobre_primario</item>
        <item name="colorSecondary">@color/color_secundario</item>
        <item name="android:windowBackground">@color/color_fondo</item>
        <item name="android:statusBarColor">@color/color_primario_oscuro</item>
    </style>

    <style name="EstiloTitulo">
        <item name="android:textSize">@dimen/tamano_titulo</item>
        <item name="android:textColor">@color/color_texto_principal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">@dimen/margen_pantalla</item>
    </style>

    <style name="EstiloTextoNormal">
        <item name="android:textSize">@dimen/tamano_texto</item>
        <item name="android:textColor">@color/color_texto_principal</item>
        <item name="android:layout_marginBottom">@dimen/margen_pequeno</item>
    </style>

    <style name="EstiloBotonPrincipal">
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:textSize">@dimen/tamano_texto</item>
        <item name="android:textColor">@color/color_texto_sobre_primario</item>
        <item name="backgroundTint">@color/color_primario</item>
        <item name="android:layout_marginTop">@dimen/margen_pequeno</item>
    </style>

</resources>